<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono adaptativo: marco redondeado con degradado azul marino -> naranja
  y panel interior color crema, replicando el icono de referencia.

  Coordenadas en lienzo 108x108. El rectángulo redondeado sobresale del lienzo
  (x/y negativos) a propósito: así el "bezel" tapa los bordes y el launcher recorta
  limpio en squircle o círculo sin dejar esquinas visibles.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Marco / bezel con degradado diagonal azul marino -> naranja -->
    <path
        android:pathData="M13,-5 L95,-5 A18,18 0 0 1 113,13 L113,95 A18,18 0 0 1 95,113 L13,113 A18,18 0 0 1 -5,95 L-5,13 A18,18 0 0 1 13,-5 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1D2B4F" />
                <item android:offset="0.55" android:color="#FF3A2F4A" />
                <item android:offset="1.0" android:color="#FFFF7A18" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Panel interior crema -->
    <path
        android:pathData="M13,6 L95,6 A7,7 0 0 1 102,13 L102,95 A7,7 0 0 1 95,102 L13,102 A7,7 0 0 1 6,95 L6,13 A7,7 0 0 1 13,6 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="6"
                android:startY="6"
                android:endX="102"
                android:endY="102"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.6" android:color="#FFF7F1ED" />
                <item android:offset="1.0" android:color="#FFFBE3D8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brillo suave en la esquina inferior derecha -->
    <path
        android:pathData="M13,6 L95,6 A7,7 0 0 1 102,13 L102,95 A7,7 0 0 1 95,102 L13,102 A7,7 0 0 1 6,95 L6,13 A7,7 0 0 1 13,6 Z"
        android:fillAlpha="0.55">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="40"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FF7A18" />
                <item android:offset="1.0" android:color="#33FF9A3C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
